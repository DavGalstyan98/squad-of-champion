# Local development only; replace credentials outside local development.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://squad:squad_local@localhost:5432/squad
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
# Docker generates/persists a private key automatically when blank.
# For npm development, run npm run config:jwt (from root); values are never printed.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_SECONDS=3600
JWT_ISSUER=squad-of-champions
JWT_AUDIENCE=squad-of-champions-frontend
# Optional test-only admin connection; must permit CREATE DATABASE and pg_trgm.
# Tests otherwise use DATABASE_URL and create/drop only their own temporary database.
# TEST_DATABASE_ADMIN_URL=postgresql://squad:squad_local@localhost:5432/squad

# Catalogue cache and dependency probe deadlines
CACHE_TTL_SECONDS=300
CACHE_NAMESPACE=catalog
REDIS_TIMEOUT_MS=200
HEALTH_TIMEOUT_MS=1000

# Squad transaction statement and row-lock deadlines (milliseconds)
SQUAD_LOCK_TIMEOUT_MS=1500
SQUAD_STATEMENT_TIMEOUT_MS=5000
