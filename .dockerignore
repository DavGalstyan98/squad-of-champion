# Allow only build inputs. Runtime configuration is supplied by Compose, never COPY.
**
!package.json
!package-lock.json
!backend/
!backend/package.json
!backend/tsconfig*.json
!backend/src/
!backend/src/**
!backend/docker-entrypoint.cjs
!backend/prune-runtime.cjs
!frontend/
!frontend/package.json
!frontend/tsconfig.json
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!frontend/nginx.conf

# Exclude sensitive/user/generated inputs even inside an allowed source tree.
**/.env
**/.env.*
**/node_modules
**/build
**/dist
**/coverage
**/.git
**/.idea
**/.vscode
**/.codex
**/.agents
**/.aws
**/.DS_Store
**/*.pdf
**/*.pem
**/*.key
**/*.p12
**/id_rsa*
**/id_ed25519*
